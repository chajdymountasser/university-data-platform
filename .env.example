# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false

# Ingestion
CONNECTOR_VERSION=1.0.0
DEFAULT_LANGUAGE=fr
INGESTION_LOG_LEVEL=INFO
AUTO_PLAYWRIGHT=false
REQUEST_DELAY=0.5

# Airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=university_platform_secret

# Spark / Phase 2
SPARK_LOG_LEVEL=INFO
HIVE_METASTORE_URL=thrift://hive-metastore:9083

# Metabase (optional — for dashboard sync)
METABASE_USER=
METABASE_PASS=

# Google Gemini (optional — for embedding generation)
# If not set, falls back to local sentence-transformers, then TF-IDF
GEMINI_API_KEY=

# Local embedding model (used when GEMINI_API_KEY is not set)
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Elasticsearch (Phase 4 — Search + Observability)
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_INDEX_FACULTY=faculty_profiles
ELASTICSEARCH_INDEX_COURSE=course_catalog
ELASTICSEARCH_INDEX_LOGS=platform-logs

# Qdrant (Phase 4 — Vector Search + RAG)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_FACULTY=faculty_profiles_chunks
QDRANT_COLLECTION_COURSE=course_catalog_chunks

# Trino SQL (Phase 2 — Hudi query engine)
# Internal Docker network: http://trino:8080 (port 8081 on host)
TRINO_URL=http://trino:8080/v1/statement

# Search API (Phase 4 — FastAPI)
SEARCH_API_HOST=0.0.0.0
SEARCH_API_PORT=8000
SEARCH_RESULT_LIMIT=20

# RAG (Gemini API — supports Gemma 4 and Gemini models)
#   gemma-4-31b-it      — best quality, slower
#   gemma-4-26b-a4b-it  — good quality, faster
#   gemini-2.0-flash    — fast fallback
RAG_MODEL=gemma-4-31b-it
RAG_MAX_CHUNKS=5
RAG_TEMPERATURE=0.3
